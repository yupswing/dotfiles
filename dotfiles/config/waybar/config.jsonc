[
  {
    "name": "embedded",
    "output": "eDP-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/media"],
    "modules-right": [
      "group/utils",
      "battery",
      "group/system",
      "group/audio",
      "tray",
    ],
  },
  {
    "name": "external",
    "output": "HDMI-A-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/media"],
    "modules-right": [
      "group/utils",
      "battery",
      "group/system",
      "group/audio",
      "tray",
    ],
  },
]
