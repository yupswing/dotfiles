{
  // ---------------------------------------------------------------------------
  // BASIC

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "!0:float": "",
      "!1:im": "",
      "!2:mail": "",
      "!3:music": "",
      "01:web": "",
      "02:code": "",
      "03:term": "",
      "04": "<span size='70%' rise='2pt'>04</span>",
      "05": "<span size='70%' rise='2pt'>05</span>",
      "06": "<span size='70%' rise='2pt'>06</span>",
      "07": "<span size='70%' rise='2pt'>07</span>",
      "08": "<span size='70%' rise='2pt'>08</span>",
      "09": "<span size='70%' rise='2pt'>09</span>",
      "10": "<span size='70%' rise='2pt'>10</span>",
      // "alert": "",
      "default": "", // se non trova mapping
    },
    "tooltip": false,
  },

  // finestra attiva del monitor della barra, non quella col focus globale
  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 60,
  },

  "tray": {
    "icon-size": 17,
    "spacing": 6,
  },

  // ---------------------------------------------------------------------------
  // GROUPS

  "group/utils": {
    "orientation": "inherit",
    "modules": ["custom/updates", "idle_inhibitor", "bluetooth", "custom/online"],
  },

  "group/system": {
    "orientation": "inherit",
    "modules": ["cpu", "memory"],
  },

  "group/audio": {
    "orientation": "inherit",
    "modules": ["custom/audio-input", "custom/audio-output", "pulseaudio"],
  },

  // ---------------------------------------------------------------------------
  // MODULES
  // Nei numeri `\u2007>` riempie a sinistra con uno spazio largo quanto una
  // cifra, cosi' il modulo non cambia larghezza anche con un font proporzionale

  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "<span color='{{@@ THEME_SECONDARY @@}}' size='130%' rise='-2pt'></span> {volume:\u2007>3}% ",
    "format-muted": "<span size='130%' rise='-2pt'></span> {volume:\u2007>3}% ",
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl -- set-sink-mute 0 toggle",
    "tooltip": false,
  },

  // sink/source di default: click per ruotare (vedi scripts/audio-node.zsh)
  "custom/audio-output": {
    "exec": "~/.config/waybar/scripts/audio-node.zsh output listen",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/audio-node.zsh output next",
    "on-click-middle": "~/.config/waybar/scripts/audio-node.zsh output mute",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "~/.config/waybar/scripts/audio-node.zsh output up",
    "on-scroll-down": "~/.config/waybar/scripts/audio-node.zsh output down",
    "tooltip": false,
  },

  "custom/audio-input": {
    "exec": "~/.config/waybar/scripts/audio-node.zsh input listen",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/audio-node.zsh input next",
    "on-click-middle": "~/.config/waybar/scripts/audio-node.zsh input mute",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up": "~/.config/waybar/scripts/audio-node.zsh input up",
    "on-scroll-down": "~/.config/waybar/scripts/audio-node.zsh input down",
    "tooltip": false,
  },

  // Temperatura del package CPU da coretemp (hwmon-path-abs perche' il numero
  // di hwmonN cambia tra un boot e l'altro); oltre la soglia la colora il CSS
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 90,
    "format": "<span color='{{@@ THEME_SECONDARY @@}}' size='130%' rise='-2pt'></span> {temperatureC:\u2007>2}°C",
    "interval": 5,
    "tooltip": false,
  },

  // icona, barra di carico e percentuale come in polybar; le soglie colorano
  // il modulo dal CSS agli stessi livelli della barra (6/8 e 8/8)
  "cpu": {
    "interval": 2,
    "format": "<span color='{{@@ THEME_SECONDARY @@}}' size='130%' rise='-2pt'></span> {usage:\u2007>2}%", // {icon}",
    // "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": { "warning": 63, "critical": 88 },
    "on-click": "kitty btop",
    "tooltip": false,
  },

  "memory": {
    "interval": 2,
    "format": "<span color='{{@@ THEME_SECONDARY @@}}' size='130%' rise='-2pt'></span> {percentage:\u2007>2}%", // {icon}",
    // "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": { "warning": 63, "critical": 88 },
    "tooltip": false,
  },

  "clock": {
    "interval": 60,
    "timezone": "Europe/Rome",
    "format": "<span color='{{@@ THEME_SECONDARY @@}}' size='130%' rise='-2pt'></span> {:%a %d %b <span color='{{@@ THEME_SECONDARY @@}}' size='130%%' rise='-2pt'></span> %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ecc6d9'><b>{}</b></span>",
        "days": "<span color='#ffead3'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
  },

  // Player multimediale (qualsiasi player MPRIS), nascosto quando nulla suona:
  // lo script emette testo vuoto e hide-empty-text nasconde il modulo.
  // Per seguire solo Spotify sostituisci media.py con media-spotify.py (stesso
  // output e stessi comandi) e, volendo, l'icona nel format con il logo 
  "custom/media": {
    "exec": "python3 ~/.config/waybar/scripts/media.py",
    "return-type": "json",
    "restart-interval": 3,
    "hide-empty-text": true,
    "format": "<span color='{{@@ THEME_SECONDARY @@}}' size='130%' rise='-2pt'></span> {icon} {text}",
    "format-icons": {
      "playing": "",
      "paused": "",
      "stopped": "",
    },
    "min-length": 20,
    "max-length": 40,
    "align": 0,
    "on-click": "python3 ~/.config/waybar/scripts/media.py toggle",
    "on-click-right": "python3 ~/.config/waybar/scripts/media.py open",
    "on-click-middle": "python3 ~/.config/waybar/scripts/media.py next",
    "on-scroll-up": "python3 ~/.config/waybar/scripts/media.py next",
    "on-scroll-down": "python3 ~/.config/waybar/scripts/media.py previous",
    "smooth-scrolling-threshold": 1,
  },

  // Aggiornamenti in attesa (repo + AUR), nascosto se non ce ne sono.
  // Icona in primary: THEME_PRIMARY (config.yaml), allineato a color5 di wal.
  // Il click apre paru e, chiuso il terminale, rilegge il conteggio (signal)
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 600,
    "signal": 8,
    "hide-empty-text": true,
    "format": "<span color='{{@@ THEME_PRIMARY @@}}' size='130%' rise='-2pt'></span> {}",
    "on-click": "kitty --hold paru; pkill -RTMIN+8 waybar",
    "tooltip": false,
  },

  // Caffeina: finché è attivo hypridle non spegne lo schermo né blocca la
  // sessione (~/.config/hypr/hypridle.conf). Il click lo attiva/disattiva
  "idle_inhibitor": {
    "format": "<span size='130%'>{icon}</span>",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊",
    },
    "tooltip-format-activated": "Keep on",
    "tooltip-format-deactivated": "Turn off and lock",
  },

  // Bluetooth: grigio dal CSS quando è spento, l'icona cambia se c'è un
  // dispositivo connesso; i dispositivi e la loro batteria sono nel tooltip.
  // Il click apre blueman-manager
  "bluetooth": {
    "format": "<span size='130%' rise='-2pt'>󰂯</span>",
    "format-connected": "<span size='130%' rise='-2pt'>󰂱</span>",
    "format-off": "<span size='130%' rise='-2pt'>󰂲</span>",
    "format-disabled": "<span size='130%' rise='-2pt'>󰂲</span>",
    "tooltip-format": "{controller_alias}: nessun dispositivo connesso",
    "tooltip-format-off": "Bluetooth spento",
    "tooltip-format-disabled": "Bluetooth disabilitato",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "blueman-manager",
  },

  // Controllo internet: il colore viene dal CSS secondo lo stato
  // (online/offline/updating), IP pubblico e locale sono nel tooltip.
  // Il click manda un segnale allo script per ricontrollare subito
  "custom/online": {
    "exec": "python3 ~/.config/waybar/scripts/online.py",
    "return-type": "json",
    "restart-interval": 5,
    "format": "<span size='130%' rise='-2pt'></span>{}",
    "on-click": "pkill -USR1 -f 'waybar/scripts/[o]nline.py'",
    "on-click-right": "xdg-open https://ifconfig.co",
  },
}
