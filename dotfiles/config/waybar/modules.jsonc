{
  // ---------------------------------------------------------------------------
  // BASIC

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "!0:float": "",
      "!1:im": "",
      "!2:mail": "",
      "!3:music": "",
      "01:web": "",
      "02:code": "",
      "03:term": "",
      "04": "04",
      "05": "05",
      "06": "06",
      "07": "07",
      "08": "08",
      "09": "09",
      "10": "10",
      // "alert": "",
      "default": "", // se non trova mapping
    },
  },

  "tray": {
    "icon-size": 17,
    "spacing": 6,
  },

  // ---------------------------------------------------------------------------
  // GROUPS

  "group/utils": {
    "orientation": "inherit",
    "modules": ["custom/updates", "custom/online"],
  },

  "group/system": {
    "orientation": "inherit",
    "modules": ["custom/temperature", "cpu", "memory"],
  },

  "group/audio": {
    "orientation": "inherit",
    "modules": ["custom/audio-input", "custom/audio-output", "pulseaudio"],
  },

  // ---------------------------------------------------------------------------
  // MODULES

  "network": {
    "format-wifi": "<span color='#f19d3a' size='130%' rise='-2pt'>󰤨</span>",
    "format-ethernet": "<span color='#f19d3a' size='130%' rise='-2pt'></span>",
    "format-linked": "<span color='#f19d3a' size='130%' rise='-2pt'>󱘖</span>{ifname} (No IP) ",
    "format-disconnected": "<span size='130%' rise='-2pt'></span>",
    "tooltip-format": " {essid} <span color='#f19d3a'>󰅧</span>{bandwidthUpBytes} <span color='#f19d3a'>󰅢</span>{bandwidthDownBytes}",
    "interval": 1,
  },

  // come in polybar: icona, percentuale e barra di carica; "Full" dal 98%.
  // Senza una batteria in /sys/class/power_supply il modulo resta nascosto
  "battery": {
    "interval": 5,
    "full-at": 98,
    "states": { "critical": 37 },
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {capacity:3}% {icon}",
    "format-charging": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {capacity:3}% {icon}",
    "format-plugged": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {capacity:3}% {icon}",
    "format-full": "<span color='#f19d3a' size='130%' rise='-2pt'></span> Full {icon}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "tooltip": true,
  },

  "pulseaudio": {
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {volume}% ",
    "format-muted": "<span size='130%' rise='-2pt'></span> {volume}% ",
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl -- set-sink-mute 0 toggle",
    "tooltip": true,
  },

  // sink/source di default: click per ruotare (vedi scripts/audio-node.zsh)
  "custom/audio-output": {
    "exec": "~/.config/waybar/scripts/audio-node.zsh output listen",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/audio-node.zsh output next",
    "on-click-middle": "~/.config/waybar/scripts/audio-node.zsh output mute",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up": "~/.config/waybar/scripts/audio-node.zsh output up",
    "on-scroll-down": "~/.config/waybar/scripts/audio-node.zsh output down",
    "tooltip": false,
  },

  "custom/audio-input": {
    "exec": "~/.config/waybar/scripts/audio-node.zsh input listen",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/audio-node.zsh input next",
    "on-click-middle": "~/.config/waybar/scripts/audio-node.zsh input mute",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up": "~/.config/waybar/scripts/audio-node.zsh input up",
    "on-scroll-down": "~/.config/waybar/scripts/audio-node.zsh input down",
    "tooltip": false,
  },

  "custom/temperature": {
    "exec": "sensors | awk '/^Package id 0:/ {print int($4)}'",
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {}°C",
    "interval": 5,
    "tooltip": false,
  },

  // icona, barra di carico e percentuale come in polybar; le soglie colorano
  // il modulo dal CSS agli stessi livelli della barra (6/8 e 8/8)
  "cpu": {
    "interval": 2,
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {usage:2}% {icon}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": { "warning": 63, "critical": 88 },
    "on-click": "kitty btop",
    "tooltip": false,
  },

  "memory": {
    "interval": 2,
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {percentage:2}% {icon}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "states": { "warning": 63, "critical": 88 },
    "tooltip": false,
  },

  "clock": {
    "interval": 1,
    "timezone": "Europe/Rome",
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span>  {:%a %d %b   <span color='#f19d3a' size='130%%' rise='-2pt'></span>  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'>{icon}</span>{percent}% ",
    "tooltip": true,
    "tooltip-format": "当前屏幕亮度: {percent}%",
    "format-icons": [
      "<span color='#f19d3a'>󰃞</span>",
      "<span color='#f19d3a'>󰃝</span>",
      "<span color='#f19d3a'>󰃟</span>",
      "<span color='#f19d3a'>󰃠</span>",
    ],
  },

  "bluetooth": {
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> ",
    // "format-connected": "<span color='#f19d3a' size='130%' rise='-2pt'></span> ",
    // "format-connected-battery": "<span color='#f19d3a' size='130%' rise='-2pt'></span> ",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
  },

  // Player multimediale (qualsiasi player MPRIS), nascosto quando nulla suona:
  // lo script emette testo vuoto e hide-empty-text nasconde il modulo.
  // Per seguire solo Spotify sostituisci media.py con media-spotify.py (stesso
  // output e stessi comandi) e, volendo, l'icona nel format con il logo 
  "custom/media": {
    "exec": "python3 ~/.config/waybar/scripts/media.py",
    "return-type": "json",
    "restart-interval": 3,
    "exec-on-event": false,
    "hide-empty-text": true,
    "format": "<span color='#f19d3a' size='130%' rise='-2pt'></span> {icon}  {text}",
    "format-icons": {
      "playing": "",
      "paused": "",
      "stopped": "",
    },
    "min-length": 20,
    "max-length": 40,
    "align": 0,
    "on-click": "python3 ~/.config/waybar/scripts/media.py toggle",
    "on-click-right": "python3 ~/.config/waybar/scripts/media.py open",
    "on-click-middle": "python3 ~/.config/waybar/scripts/media.py next",
    "on-scroll-down": "python3 ~/.config/waybar/scripts/media.py previous",
  },

  // Aggiornamenti in attesa (repo + AUR), nascosto se non ce ne sono.
  // Icona in primary: tieni l'hex allineato a color5 del tema wal.
  // Il click apre paru e, chiuso il terminale, rilegge il conteggio (signal)
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 600,
    "signal": 8,
    "hide-empty-text": true,
    "format": "<span color='#9358fe' size='130%' rise='-2pt'></span> {}",
    "on-click": "kitty --hold paru; pkill -RTMIN+8 waybar",
    "tooltip": false,
  },

  // Controllo internet: il colore viene dal CSS secondo lo stato
  // (online/offline/updating), IP pubblico e locale sono nel tooltip.
  // Il click manda un segnale allo script per ricontrollare subito
  "custom/online": {
    "exec": "python3 ~/.config/waybar/scripts/online.py 60",
    "return-type": "json",
    "restart-interval": 5,
    "format": "<span size='130%' rise='-2pt'></span>{}",
    "on-click": "pkill -USR1 -f 'waybar/scripts/[o]nline.py'",
    "on-click-right": "xdg-open https://ifconfig.co",
  },
}
